# Copy to .env.local and fill in. .env.local is gitignored — never commit a real token.

# HuggingFace token, used for both speech-to-text and grading.
# Create one at https://huggingface.co/settings/tokens with the
# "Make calls to Inference Providers" permission. The free tier is enough.
HF_TOKEN=

# Signs the session cookie. Any random string; changing it logs everyone out.
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=

# --- Where the models run (all optional) ----------------------------------------
# Three roles — ASR, JUDGE, TTS — and four variables each. Unset means the defaults in
# src/constants/constants.py on the HuggingFace Inference API, which is what HF_TOKEN
# above pays for. Setting <ROLE>_URL switches that role to any OpenAI-compatible
# server; the other three are optional even then.
#
#   <ROLE>_URL      base url, e.g. https://api.groq.com/openai/v1
#   <ROLE>_MODEL    the model name that server knows it by
#   <ROLE>_KEY      its api key; falls back to HF_TOKEN, and local servers ignore it
#   <ROLE>_TIMEOUT  seconds; must stay under JOB_STALE_MINUTES or work is re-queued
#
# ASR on Groq — published at $0.04/audio-hour, where HF routing publishes no rate:
# ASR_URL=https://api.groq.com/openai/v1
# ASR_MODEL=whisper-large-v3-turbo
# ASR_KEY=gsk_...
#
# The judge on a local Ollama, which costs nothing and needs no key:
# JUDGE_URL=http://localhost:11434/v1
# JUDGE_MODEL=qwen2.5:14b
